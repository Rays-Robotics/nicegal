# One FFmpeg configure option per line. This is a static, local-file-only build.
--toolchain=msvc
--target-os=win32
--arch=x86_64
--enable-static
--disable-shared
--disable-doc
--disable-debug
--disable-programs
--disable-autodetect
--disable-everything
--disable-network
--disable-hwaccels
--disable-d3d11va
--disable-d3d12va
--disable-dxva2
--disable-mediafoundation
--disable-avdevice
--enable-avfilter
--disable-swresample
--enable-avcodec
--enable-avformat
--enable-swscale
--enable-filter=buffer,buffersink,scale,format,transpose,rotate,hflip,vflip
--enable-protocol=file
--enable-demuxer=mov,matroska,avi,mpegts,mpegps,ivf
--enable-parser=h264,hevc,vp8,vp9,av1,mpeg4video,mpegvideo,mjpeg
--enable-decoder=h264,hevc,vp8,vp9,av1,mpeg2video,mpeg4,mjpeg
--extra-cflags=-MD
